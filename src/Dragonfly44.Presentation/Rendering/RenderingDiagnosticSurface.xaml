<UserControl
    x:Class="Dragonfly44.Presentation.Rendering.RenderingDiagnosticSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rendering="using:Dragonfly44.Presentation.Rendering"
    mc:Ignorable="d">

    <Grid Background="{StaticResource DragonflyPlaceholderSurfaceBrush}"
          BorderBrush="{StaticResource DragonflyPlaceholderBorderBrush}"
          BorderThickness="{StaticResource DragonflyBorderThin}"
          CornerRadius="{StaticResource DragonflyRadiusMedium}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0"
                Padding="12,8"
                BorderBrush="{StaticResource DragonflyPlaceholderBorderBrush}"
                BorderThickness="0,0,0,1"
                Background="{StaticResource DragonflyPlaceholderSurfaceSubtleBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Win2D GPU Rendering Verification"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource DragonflyPlaceholderFontSizeBody}"
                               Foreground="{StaticResource DragonflyPlaceholderTextPrimaryBrush}" />
                    <TextBlock x:Name="StatusBadge"
                               Text="Initializing..."
                               FontSize="{StaticResource DragonflyPlaceholderFontSizeSmall}"
                               Foreground="{StaticResource DragonflyPlaceholderSuccessBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="RedrawButton"
                        Content="Invalidate / Repaint"
                        FontSize="{StaticResource DragonflyPlaceholderFontSizeSmall}"
                        Padding="8,4"
                        Click="OnRedrawClicked" />
            </Grid>
        </Border>

        <!-- Win2D Drawing Surface -->
        <Border Grid.Row="1" MinHeight="180" Background="#0C0C0E">
            <rendering:Win2DRenderSurface x:Name="RenderSurface"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
        </Border>

        <!-- Metrics Footer -->
        <Border Grid.Row="2"
                Padding="12,6"
                BorderBrush="{StaticResource DragonflyPlaceholderBorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{StaticResource DragonflyPlaceholderSurfaceSubtleBrush}">
            <Grid ColumnDefinitions="*,*,*">
                <TextBlock Grid.Column="0"
                           x:Name="MetricsDrawCount"
                           Text="Draw Cycles: 0"
                           FontSize="{StaticResource DragonflyPlaceholderFontSizeSmall}"
                           Foreground="{StaticResource DragonflyPlaceholderTextSecondaryBrush}" />
                <TextBlock Grid.Column="1"
                           x:Name="MetricsDpi"
                           Text="DPI: 96 (1.0x)"
                           FontSize="{StaticResource DragonflyPlaceholderFontSizeSmall}"
                           Foreground="{StaticResource DragonflyPlaceholderTextSecondaryBrush}" />
                <TextBlock Grid.Column="2"
                           x:Name="MetricsResolution"
                           Text="Surface: 0 x 0"
                           FontSize="{StaticResource DragonflyPlaceholderFontSizeSmall}"
                           Foreground="{StaticResource DragonflyPlaceholderTextSecondaryBrush}"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
