<UserControl
    x:Class="Dragonfly44.Presentation.Controls.DialogueFeedControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Dragonfly44.Presentation.ViewModels"
    xmlns:controls="using:Dragonfly44.Presentation.Controls"
    xmlns:enums="using:Dragonfly44.Domain.Enums"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="440">

    <Grid Background="{StaticResource DragonflyPlaceholderSurfaceColor}"
          BorderBrush="{StaticResource DragonflyPlaceholderBorderBrush}"
          BorderThickness="1,0,0,0">
        <Grid.RowDefinitions>
            <!-- Header & Filter Bar -->
            <RowDefinition Height="Auto" />
            <!-- Virtualized Cards List -->
            <RowDefinition Height="*" />
            <!-- Footer Status / Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Feed Header -->
        <Border Grid.Row="0"
                Background="{StaticResource DragonflyPlaceholderTitleBarBgBrush}"
                BorderBrush="{StaticResource DragonflyPlaceholderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Title & Add Button -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="💬 Dialogue Feed"
                                   FontSize="{StaticResource DragonflyPlaceholderFontSizeBody}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DragonflyPlaceholderTextPrimaryBrush}" />
                        <Border Background="{StaticResource DragonflyPlaceholderSurfaceSubtleBrush}"
                                CornerRadius="{StaticResource DragonflyRadiusSmall}"
                                Padding="6,1">
                            <TextBlock Text="{x:Bind ViewModel.TotalCardCount, Mode=OneWay}"
                                       FontSize="{StaticResource DragonflyPlaceholderFontSizeSmall}"
                                       Foreground="{StaticResource DragonflyPlaceholderAccentBrush}"
                                       FontWeight="Medium" />
                        </Border>
                    </StackPanel>

                    <controls:CustomButton Content="+ Add Dialogue"
                                           HorizontalAlignment="Right"
                                           Click="OnAddDialogueClicked"
                                           Height="26"
                                           Padding="8,2" />
                </Grid>

                <!-- Row 1: Filters (All / Flagged) -->
                <Grid Grid.Row="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:CustomButton Content="All"
                                               Click="OnFilterAllClicked"
                                               Height="26"
                                               Padding="12,2"
                                               Background="{x:Bind ViewModel.FilterAllBackground, Mode=OneWay}" />
                        <controls:CustomButton Content="🚩 Flagged"
                                               Click="OnFilterFlaggedClicked"
                                               Height="26"
                                               Padding="12,2"
                                               Background="{x:Bind ViewModel.FilterFlaggedBackground, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource DragonflyPlaceholderFontSizeSmall}"
                               Foreground="{StaticResource DragonflyPlaceholderTextMutedBrush}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Virtualized Dialogue Cards Feed -->
        <ListView x:Name="DialogueCardsListView"
                  Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.VisibleCards, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedCard, Mode=TwoWay}"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged"
                  Padding="12,10"
                  KeyDown="OnFeedKeyDown">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,0,0,8" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DialogueCardViewModel">
                    <Border Background="{StaticResource DragonflyPlaceholderSurfaceBrush}"
                            BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}"
                            BorderThickness="{x:Bind CardBorderThickness, Mode=OneWay}"
                            CornerRadius="{StaticResource DragonflyRadiusMedium}"
                            Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Top Bar: Number, TypeR Prefix, Classification, Actions -->
                                <RowDefinition Height="Auto" />
                                <!-- Source Text Area -->
                                <RowDefinition Height="Auto" />
                                <!-- Arabic Translation Area -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top Bar -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Grabber, Number Badge, Page indicator, and TypeR Prefix Badge -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <!-- Display Number Badge -->
                                    <Border Background="{StaticResource DragonflyPlaceholderSurfaceSubtleBrush}"
                                            CornerRadius="{StaticResource DragonflyRadiusSmall}"
                                            Padding="6,2">
                                        <TextBlock Text="{x:Bind DisplayNumberText, Mode=OneWay}"
                                                   FontSize="{StaticResource DragonflyPlaceholderFontSizeSmall}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource DragonflyPlaceholderAccentBrush}" />
                                    </Border>

                                    <!-- Page Badge -->
                                    <TextBlock Text="{x:Bind PageBadgeText, Mode=OneWay}"
                                               FontSize="{StaticResource DragonflyPlaceholderFontSizeSmall}"
                                               Foreground="{StaticResource DragonflyPlaceholderTextMutedBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- TypeR Prefix Badge (Isolated LTR) -->
                                    <Border Background="{StaticResource DragonflyPlaceholderWindowBgBrush}"
                                            BorderBrush="{StaticResource DragonflyPlaceholderBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource DragonflyRadiusSmall}"
                                            Padding="6,2"
                                            FlowDirection="LeftToRight">
                                        <TextBlock Text="{x:Bind TypeRPrefix, Mode=OneWay}"
                                                   FontFamily="{StaticResource DragonflyPlaceholderFontMonospace}"
                                                   FontSize="{StaticResource DragonflyPlaceholderFontSizeSmall}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource DragonflyPlaceholderSuccessBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- Center: Classification Selector Dropdown -->
                                <ComboBox Grid.Column="1"
                                          Margin="8,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          FontSize="{StaticResource DragonflyPlaceholderFontSizeSmall}"
                                          Height="24"
                                          Padding="6,0"
                                          SelectedIndex="{x:Bind ClassificationIndex, Mode=TwoWay}"
                                          SelectionChanged="OnClassificationChanged"
                                          Tag="{x:Bind}">
                                    <ComboBoxItem Content="Speech (REG:)" />
                                    <ComboBoxItem Content="Shout (SHOUT:)" />
                                    <ComboBoxItem Content="Whisper (WHIS:)" />
                                    <ComboBoxItem Content="Thought (THO:)" />
                                    <ComboBoxItem Content="Narration (NAR:)" />
                                    <ComboBoxItem Content="SFX (SFX:)" />
                                </ComboBox>

                                <!-- Right: Reorder Up/Down, Flag, and Delete Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <!-- Move Up -->
                                    <controls:CustomButton Content="▲"
                                                           Click="OnMoveUpClicked"
                                                           Tag="{x:Bind}"
                                                           Height="24"
                                                           Width="24"
                                                           Padding="0"
                                                           FontSize="9" />

                                    <!-- Move Down -->
                                    <controls:CustomButton Content="▼"
                                                           Click="OnMoveDownClicked"
                                                           Tag="{x:Bind}"
                                                           Height="24"
                                                           Width="24"
                                                           Padding="0"
                                                           FontSize="9" />

                                    <!-- Flag Button -->
                                    <controls:CustomButton Content="{x:Bind FlagIcon, Mode=OneWay}"
                                                           Click="OnToggleFlagClicked"
                                                           Tag="{x:Bind}"
                                                           Height="24"
                                                           Width="26"
                                                           Padding="0"
                                                           FontSize="11"
                                                           Foreground="{x:Bind FlagBrush, Mode=OneWay}" />

                                    <!-- Delete Button -->
                                    <controls:CustomButton Content="✕"
                                                           Click="OnDeleteCardClicked"
                                                           Tag="{x:Bind}"
                                                           Height="24"
                                                           Width="24"
                                                           Padding="0"
                                                           FontSize="10"
                                                           Foreground="{StaticResource DragonflyPlaceholderErrorBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: Source / Original Text Display -->
                            <StackPanel Grid.Row="1" Spacing="3" Margin="0,0,0,6">
                                <Grid>
                                    <TextBlock Text="ORIGINAL / RAW"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource DragonflyPlaceholderTextMutedBrush}"
                                               VerticalAlignment="Center" />
                                    <!-- AI Translate Trigger Button -->
                                    <controls:CustomButton Content="{x:Bind TranslatingStatusText, Mode=OneWay}"
                                                           Click="OnAiTranslateClicked"
                                                           Tag="{x:Bind}"
                                                           IsEnabled="{x:Bind CanTranslateWithAi, Mode=OneWay}"
                                                           Height="22"
                                                           Padding="8,1"
                                                           FontSize="10"
                                                           HorizontalAlignment="Right" />
                                </Grid>
                                <TextBox Text="{x:Bind RawText, Mode=TwoWay}"
                                         PlaceholderText="Source text..."
                                         FontSize="{StaticResource DragonflyPlaceholderFontSizeBody}"
                                         Foreground="{StaticResource DragonflyPlaceholderTextSecondaryBrush}"
                                         Background="{StaticResource DragonflyPlaceholderSurfaceSubtleBrush}"
                                         BorderBrush="{StaticResource DragonflyPlaceholderBorderBrush}"
                                         BorderThickness="1"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="32"
                                         MaxHeight="90"
                                         LostFocus="OnCardTextLostFocus"
                                         Tag="{x:Bind}" />

                                <!-- Translation Error Alert Banner -->
                                <Border Visibility="{x:Bind HasTranslationErrorVisibility, Mode=OneWay}"
                                        Background="{StaticResource DragonflyPlaceholderSurfaceSubtleBrush}"
                                        BorderBrush="{StaticResource DragonflyPlaceholderErrorBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource DragonflyRadiusSmall}"
                                        Padding="8,4"
                                        Margin="0,4,0,0">
                                    <TextBlock Text="{x:Bind TranslationError, Mode=OneWay}"
                                               Foreground="{StaticResource DragonflyPlaceholderErrorBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                </Border>

                                <!-- AI Suggestion Review Box (Guarantees no silent overwriting) -->
                                <Border Visibility="{x:Bind HasPendingAiTranslationVisibility, Mode=OneWay}"
                                        Background="{StaticResource DragonflyPlaceholderWindowBgBrush}"
                                        BorderBrush="{StaticResource DragonflyPlaceholderAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource DragonflyRadiusSmall}"
                                        Padding="10,8"
                                        Margin="0,6,0,0">
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="🤖 AI Suggestion"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource DragonflyPlaceholderAccentBrush}" />
                                                <TextBlock Text="• Review &amp; Accept"
                                                           FontSize="10"
                                                           Foreground="{StaticResource DragonflyPlaceholderTextMutedBrush}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                <controls:CustomButton Content="✓ Accept"
                                                                       Click="OnAcceptAiTranslationClicked"
                                                                       Tag="{x:Bind}"
                                                                       Height="22"
                                                                       Padding="8,1"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource DragonflyPlaceholderSuccessBrush}" />
                                                <controls:CustomButton Content="✕ Discard"
                                                                       Click="OnRejectAiTranslationClicked"
                                                                       Tag="{x:Bind}"
                                                                       Height="22"
                                                                       Padding="8,1"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource DragonflyPlaceholderTextMutedBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Suggested Arabic Text -->
                                        <Border Background="{StaticResource DragonflyPlaceholderSurfaceSubtleBrush}"
                                                CornerRadius="{StaticResource DragonflyRadiusSmall}"
                                                Padding="8,6">
                                            <TextBlock Text="{x:Bind PendingAiTranslation, Mode=OneWay}"
                                                       FlowDirection="RightToLeft"
                                                       TextAlignment="Right"
                                                       FontFamily="{StaticResource DragonflyPlaceholderFontUi}"
                                                       FontSize="{StaticResource DragonflyPlaceholderFontSizeMedium}"
                                                       Foreground="{StaticResource DragonflyPlaceholderTextPrimaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </Border>

                                        <!-- AI Notes (ambiguity, nuances, honorifics) -->
                                        <TextBlock Visibility="{x:Bind HasPendingAiNotesVisibility, Mode=OneWay}"
                                                   Text="{x:Bind PendingAiNotes, Mode=OneWay}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource DragonflyPlaceholderTextMutedBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Row 2: Arabic Translation Textarea (Critical RTL Requirements) -->
                            <StackPanel Grid.Row="2" Spacing="3">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="ARABIC TRANSLATION"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource DragonflyPlaceholderAccentBrush}" />
                                        <!-- AI Tag Badge -->
                                        <Border Visibility="{x:Bind IsAiBadgeVisible, Mode=OneWay}"
                                                Background="{StaticResource DragonflyPlaceholderSurfaceSubtleBrush}"
                                                CornerRadius="{StaticResource DragonflyRadiusSmall}"
                                                Padding="4,1">
                                            <TextBlock Text="{x:Bind AiBadgeText, Mode=OneWay}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource DragonflyPlaceholderAccentBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <!-- Revert to Manual Button -->
                                        <controls:CustomButton Visibility="{x:Bind CanRevertToManualVisibility, Mode=OneWay}"
                                                               Content="↺ Revert to Manual"
                                                               Click="OnRevertToManualClicked"
                                                               Tag="{x:Bind}"
                                                               Height="20"
                                                               Padding="6,1"
                                                               FontSize="10" />
                                        <TextBlock Text="RTL • العربية"
                                                   FontSize="10"
                                                   Foreground="{StaticResource DragonflyPlaceholderTextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- Arabic RTL Textbox with Auto Expansion -->
                                <TextBox Text="{x:Bind TranslatedText, Mode=TwoWay}"
                                         PlaceholderText="اكتب الترجمة العربية هنا..."
                                         FlowDirection="RightToLeft"
                                         TextAlignment="Right"
                                         FontFamily="{StaticResource DragonflyPlaceholderFontUi}"
                                         FontSize="{StaticResource DragonflyPlaceholderFontSizeMedium}"
                                         Foreground="{StaticResource DragonflyPlaceholderTextPrimaryBrush}"
                                         Background="{StaticResource DragonflyPlaceholderWindowBgBrush}"
                                         BorderBrush="{StaticResource DragonflyPlaceholderBorderFocusBrush}"
                                         BorderThickness="1"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="60"
                                         MaxHeight="240"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         GotFocus="OnArabicTextBoxGotFocus"
                                         LostFocus="OnCardTextLostFocus"
                                         KeyDown="OnArabicTextBoxKeyDown"
                                         Tag="{x:Bind}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Footer / Keyboard Shortcuts Hint -->
        <Border Grid.Row="2"
                Background="{StaticResource DragonflyPlaceholderTitleBarBgBrush}"
                BorderBrush="{StaticResource DragonflyPlaceholderBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock Text="⌨ Shortcuts: ▲/▼ Navigate • Enter Edit • Esc Save • Ctrl+F Flag"
                       FontSize="10"
                       Foreground="{StaticResource DragonflyPlaceholderTextMutedBrush}"
                       HorizontalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
