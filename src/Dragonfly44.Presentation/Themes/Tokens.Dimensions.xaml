<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ================================================================================
    DRAGONFLY 44 — TECHNICAL PLACEHOLDER DIMENSION TOKENS
    These dimensions are neutral engineering placeholders for Phase 2 infrastructure.
    ================================================================================
    -->

    <!-- Spacing Steps -->
    <x:Double x:Key="DragonflySpace2">2</x:Double>
    <x:Double x:Key="DragonflySpace4">4</x:Double>
    <x:Double x:Key="DragonflySpace8">8</x:Double>
    <x:Double x:Key="DragonflySpace12">12</x:Double>
    <x:Double x:Key="DragonflySpace16">16</x:Double>
    <x:Double x:Key="DragonflySpace20">20</x:Double>
    <x:Double x:Key="DragonflySpace24">24</x:Double>
    <x:Double x:Key="DragonflySpace32">32</x:Double>
    <x:Double x:Key="DragonflySpace48">48</x:Double>

    <Thickness x:Key="DragonflyPaddingSmall">6,4</Thickness>
    <Thickness x:Key="DragonflyPaddingMedium">12,8</Thickness>
    <Thickness x:Key="DragonflyPaddingLarge">16,12</Thickness>
    <Thickness x:Key="DragonflyPaddingDialog">24,20</Thickness>

    <!-- Corner Radii -->
    <CornerRadius x:Key="DragonflyRadiusNone">0</CornerRadius>
    <CornerRadius x:Key="DragonflyRadiusSmall">2</CornerRadius>
    <CornerRadius x:Key="DragonflyRadiusMedium">4</CornerRadius>
    <CornerRadius x:Key="DragonflyRadiusLarge">8</CornerRadius>

    <!-- Border Thicknesses -->
    <Thickness x:Key="DragonflyBorderNone">0</Thickness>
    <Thickness x:Key="DragonflyBorderThin">1</Thickness>
    <Thickness x:Key="DragonflyBorderMedium">2</Thickness>

    <!-- Control Sizing -->
    <x:Double x:Key="DragonflyButtonHeightSmall">26</x:Double>
    <x:Double x:Key="DragonflyButtonHeightMedium">32</x:Double>
    <x:Double x:Key="DragonflyTitleBarHeight">38</x:Double>

</ResourceDictionary>
