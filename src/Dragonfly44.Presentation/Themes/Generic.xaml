<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Dragonfly44.Presentation.Controls"
    xmlns:windowing="using:Dragonfly44.Presentation.Windowing">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/DesignSystem.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
    ================================================================================
    DRAGONFLY 44 — CUSTOM CONTROL DEFAULT TEMPLATES (GENERIC.XAML)
    Architecture demonstrating clean separation of appearance from behavior.
    All visuals are driven by centralized technical tokens.
    ================================================================================
    -->

    <!-- CustomTitleBar Template -->
    <Style TargetType="windowing:CustomTitleBar">
        <Setter Property="Height" Value="{StaticResource DragonflyTitleBarHeight}" />
        <Setter Property="Background" Value="{StaticResource DragonflyPlaceholderTitleBarBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DragonflyPlaceholderTextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="windowing:CustomTitleBar">
                    <Grid Background="{TemplateBinding Background}" Height="{TemplateBinding Height}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Leading Brand / Icon Area -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0" Spacing="8">
                            <TextBlock Text="✦" FontSize="14" Foreground="{StaticResource DragonflyPlaceholderAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Title}"
                                       FontSize="{StaticResource DragonflyPlaceholderFontSizeBody}"
                                       FontWeight="Medium"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Drag Area (Middle Space) -->
                        <Border x:Name="PART_DragRegion"
                                Grid.Column="1"
                                Background="Transparent"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />

                        <!-- Window Control Buttons (Min, Max/Restore, Close) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                            <Button x:Name="PART_MinimizeButton"
                                    Width="46"
                                    Height="{StaticResource DragonflyTitleBarHeight}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="0"
                                    Content="🗕"
                                    FontSize="11"
                                    Foreground="{StaticResource DragonflyPlaceholderTextSecondaryBrush}" />
                            <Button x:Name="PART_MaximizeButton"
                                    Width="46"
                                    Height="{StaticResource DragonflyTitleBarHeight}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="0"
                                    Content="🗖"
                                    FontSize="11"
                                    Foreground="{StaticResource DragonflyPlaceholderTextSecondaryBrush}" />
                            <Button x:Name="PART_CloseButton"
                                    Width="46"
                                    Height="{StaticResource DragonflyTitleBarHeight}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="0"
                                    Content="✕"
                                    FontSize="11"
                                    Foreground="{StaticResource DragonflyPlaceholderTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CustomButton Template with Visual States -->
    <Style TargetType="controls:CustomButton">
        <Setter Property="Background" Value="{StaticResource DragonflyPlaceholderSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DragonflyPlaceholderTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DragonflyPlaceholderBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource DragonflyBorderThin}" />
        <Setter Property="Padding" Value="{StaticResource DragonflyPaddingMedium}" />
        <Setter Property="CornerRadius" Value="{StaticResource DragonflyRadiusSmall}" />
        <Setter Property="MinHeight" Value="{StaticResource DragonflyButtonHeightMedium}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource DragonflyPlaceholderFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource DragonflyPlaceholderFontSizeBody}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:CustomButton">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{StaticResource DragonflyPlaceholderHoverBrush}" />
                                        <Setter Target="RootBorder.BorderBrush" Value="{StaticResource DragonflyPlaceholderBorderFocusBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{StaticResource DragonflyPlaceholderPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{StaticResource DragonflyPlaceholderDisabledBrush}" />
                                        <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.BorderBrush" Value="{StaticResource DragonflyPlaceholderAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CustomDialogHost Template -->
    <Style TargetType="controls:CustomDialogHost">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:CustomDialogHost">
                    <!-- Modal Dimmer Overlay -->
                    <Grid Background="#A0000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <!-- Dialog Card -->
                        <Border Background="{StaticResource DragonflyPlaceholderSurfaceColor}"
                                BorderBrush="{StaticResource DragonflyPlaceholderBorderBrush}"
                                BorderThickness="{StaticResource DragonflyBorderThin}"
                                CornerRadius="{StaticResource DragonflyRadiusMedium}"
                                Padding="{StaticResource DragonflyPaddingDialog}"
                                MaxWidth="480"
                                MinWidth="320"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <StackPanel Spacing="16">
                                <!-- Title -->
                                <TextBlock Text="{TemplateBinding DialogTitle}"
                                           FontSize="{StaticResource DragonflyPlaceholderFontSizeHeading}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource DragonflyPlaceholderTextPrimaryBrush}" />

                                <!-- Message Body -->
                                <TextBlock Text="{TemplateBinding DialogMessage}"
                                           FontSize="{StaticResource DragonflyPlaceholderFontSizeBody}"
                                           Foreground="{StaticResource DragonflyPlaceholderTextSecondaryBrush}"
                                           TextWrapping="Wrap" />

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                                    <Button x:Name="PART_CancelButton"
                                            Content="{TemplateBinding CancelButtonText}"
                                            Padding="12,6" />
                                    <Button x:Name="PART_SecondaryButton"
                                            Content="{TemplateBinding SecondaryButtonText}"
                                            Padding="12,6" />
                                    <Button x:Name="PART_PrimaryButton"
                                            Content="{TemplateBinding PrimaryButtonText}"
                                            Padding="12,6" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
